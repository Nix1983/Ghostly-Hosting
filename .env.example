# shellcheck disable=SC2034
# ☁️ Cloudflare API Token
# Used to manage DNS records (A/AAAA/TXT/MX), toggle proxy status, and automate certificate setup.
# Requires permissions: Zone:DNS:Edit for the relevant domains.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# 🖥️ UpCloud API Credentials
# Used for managing infrastructure (e.g., setting reverse DNS / PTR records, firewall rules).
# Your UpCloud username and password are required for authenticated API calls.
UPCLOUD_API_USER=your_upcloud_username
UPCLOUD_API_PASS=your_upcloud_password

# 🐙 GitHub API Token
# Used to authenticate and interact with the GitHub API to list repositories,
# fetch branches/tags, clone private repositories, and resolve commit hashes.
# Token must have at least the 'repo' scope for private repositories.
GITHUB_API_TOKEN=ghp_your_token_here


